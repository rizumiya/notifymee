      "pattern": "WhatsApp Web sedang aktif"
    },
    {
      "packageName": "com.whatsapp",
      "pattern": "Mencadangkan pesan"
    },
    {
      "packageName": "com.whatsapp",
      "pattern": " Mencari pesan baru"
    }
  ]
