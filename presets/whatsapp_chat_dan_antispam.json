{
  "format": "notifymee_package_bundle_v2",
  "export_name": "whatsapp_chat_dan_antispam.json",
  "description": "Aturan penerus pesan masuk WhatsApp dilengkapi filter Blacklist otomatis untuk notifikasi sistem/sinkronisasi WhatsApp.",
  "package_filter": "com.whatsapp",
  "exported_at": "2026-11-06T17:40:00Z",
  "rules": [
    {
      "id": "preset_wa_chat_01",
